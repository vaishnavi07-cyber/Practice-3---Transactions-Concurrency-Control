-- ======================================================
-- PART A: DEADLOCK SIMULATION
-- ======================================================
-- Open TWO separate sessions (Session 1 & Session 2)
-- Run the commands below in the order shown.

-- ===== Session 1 =====
START TRANSACTION;
UPDATE StudentEnrollments
SET enrollment_date = '2024-08-01'
WHERE student_id = 1;
-- Wait here until instructed to run next update

-- ===== Session 2 =====
START TRANSACTION;
UPDATE StudentEnrollments
SET enrollment_date = '2024-09-01'
WHERE student_id = 2;
-- Wait here until instructed to run next update

-- ===== Session 1 (continue) =====
UPDATE StudentEnrollments
SET enrollment_date = '2024-08-02'
WHERE student_id = 2;
-- This will WAIT because Session 2 holds row 2

-- ===== Session 2 (continue) =====
UPDATE StudentEnrollments
SET enrollment_date = '2024-09-02'
WHERE student_id = 1;
-- This will cause DEADLOCK ERROR in one session:
-- MySQL: ERROR 1213 (40001): Deadlock found...
-- PostgreSQL: ERROR: deadlock detected

-- Commit in the session that did not fail
COMMIT;

SELECT * FROM StudentEnrollments;

-- ======================================================
-- PART B: MVCC SNAPSHOT READ
-- ======================================================
-- Reset data for clean MVCC test
UPDATE StudentEnrollments
SET enrollment_date = '2024-06-01'
WHERE student_id = 1;

-- ===== Session 1 (Reader) =====
SET TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT enrollment_date
FROM StudentEnrollments
WHERE student_id = 1;
-- Output: 2024-06-01 (snapshot)

-- ===== Session 2 (Writer) =====
START TRANSACTION;
UPDATE StudentEnrollments
SET enrollment_date = '2024-07-10'
WHERE student_id = 1;
COMMIT;

-- ===== Session 1 (still open) =====
SELECT enrollment_date
FROM StudentEnrollments
WHERE student_id = 1;
-- Output: still 2024-06-01 (old snapshot)
COMMIT;

-- After commit, Session 1 will see new value
SELECT enrollment_date
FROM StudentEnrollments
WHERE student_id = 1;
-- Output: 2024-07-10

-- ======================================================
-- PART C: LOCKING VS MVCC
-- ======================================================
-- Scenario 1: Locking (Blocking)
-- ===== Session 1 =====
START TRANSACTION;
SELECT enrollment_date
FROM StudentEnrollments
WHERE student_id = 1
FOR UPDATE;
-- Locks the row

-- ===== Session 2 =====
SELECT enrollment_date
FROM StudentEnrollments
WHERE student_id = 1;
-- This will BLOCK until Session 1 commits

-- Commit Session 1 to release lock
COMMIT;

-- Scenario 2: MVCC (No Blocking)
-- ===== Session 1 =====
SET TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT enrollment_date
FROM StudentEnrollments
WHERE student_id = 1;
-- Snapshot read, no lock

-- ===== Session 2 =====
UPDATE StudentEnrollments
SET enrollment_date = '2024-08-15'
WHERE student_id = 1;
COMMIT;

-- ===== Session 1 (still open) =====
SELECT enrollment_date
FROM StudentEnrollments
WHERE student_id = 1;
-- Output: old snapshot value (2024-07-10)

COMMIT;

-- After commit, Session 1 sees:
SELECT enrollment_date
FROM StudentEnrollments
WHERE student_id = 1;
-- Output: 2024-08-15
